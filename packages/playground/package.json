    "@codemirror/view": "^6.43.8",
    "@traceflow/core": "workspace:*",
    "@traceflow/themes": "workspace:*",
    "codemirror": "^6.0.1",
    "dompurify": "^3.4.13",
    "lz-string": "^1.5.0",
