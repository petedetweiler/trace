{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.peterdetweiler.com/schema/traceflow.schema.json",
  "title": "Traceflow document",
  "description": "AI-friendly flow diagram schema for Traceflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "version": { "const": 1, "default": 1 },
    "title": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "theme": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["light", "dark", "system"] },
            "overrides": { "type": "object" }
          }
        }
      ]
    },
    "direction": { "$ref": "#/$defs/direction" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/edge" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "direction": {
      "enum": ["TB", "LR", "BT", "RL"],
      "default": "TB"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "enum": ["start", "end", "process", "decision", "database", "external", "manual", "delay"],
          "default": "process"
        },
        "description": { "type": "string", "maxLength": 1000 },
        "icon": {
          "type": "string",
          "maxLength": 200,
          "description": "Built-in icon name or a short custom glyph such as an emoji."
        },
        "emphasis": { "enum": ["low", "normal", "high"], "default": "normal" },
        "status": { "enum": ["default", "success", "warning", "error"], "default": "default" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "from": { "type": "string", "minLength": 1, "maxLength": 200 },
        "to": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "kind": {
          "enum": ["primary", "success", "failure", "warning", "retry", "alternate"],
          "default": "primary"
        },
        "style": { "enum": ["solid", "dashed", "dotted"], "default": "solid" },
        "animate": { "type": "boolean", "default": false }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 200 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "color": { "type": "string", "maxLength": 200, "description": "Optional CSS hex color for the swimlane tint." }
      }
    }
  }
}
