{
  "name": "traceflow",
  "private": true,
  "version": "0.0.0",
  "description": "AI-first diagram rendering library — YAML in, beautiful SVG out",
  "scripts": {
    "dev": "pnpm --filter @traceflow/playground dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @traceflow/core build",
    "build:themes": "pnpm --filter @traceflow/themes build",
    "build:playground": "pnpm --filter @traceflow/playground build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint packages --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "diagrams",
    "flowchart",
    "svg",
    "yaml",
    "ai",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
